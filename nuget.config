<?xml version="1.0" encoding="utf-8"?>
<!--
  Packages come from nuget.org and from a local feed: the .NET-Web-Api-Toolkit repository cloned next
  to this one ("dotnet build" there writes the .nupkg files to bin\Packages). No GitHub token needed.
  Web.Api.Toolkit.* may only come from the local feed, so a same-named package on nuget.org is never used.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="web-api-toolkit" value="../.NET-Web-Api-Toolkit/bin/Packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="web-api-toolkit">
      <package pattern="Web.Api.Toolkit.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
